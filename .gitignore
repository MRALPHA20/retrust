# Generated data. All of it is rebuilt by `make ingest` and `retrust refresh`
# from public sources, so none of it belongs in the repository -- together it
# is about 32 MB, and the advisory corpus is a separate upstream project.
data/CSAF/
data/retrust.db
data/formula-validation.json
data/screening.json
# Derived from screening.json: the built screening index, so a 7.5 MB list
# is parsed once per refresh instead of once per command. Rebuilt whenever the
# source file changes.
data/screening-index.db
data/certifications.json
data/kev.json
data/epss.csv
data/epss.csv.gz

# Vendor trusted-provider feeds fetched by `retrust provider` (hundreds of
# advisories plus their digest and signature sidecars). Fetched data, like the
# corpus itself: rebuilt by one command, so it does not belong in the history.
data/CSAF-providers/

# The CISA signing keyring, built by `retrust verify --fetch-key`. Key trust
# comes from CISA's provider metadata agreeing with the corpus signatures, not
# from this repository -- shipping it would make the repo a key source.
data/csaf-keyring.gpg
*.gpg~

# Portable snapshots (~4 MB each). Ship these as release assets, not commits.
*-snapshot.zip
retrust-snapshot.zip

# Generated output.
reports/
docs/screenshots/

# A user's own scoring weights are theirs, not the project's default.
retrust.config.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store

# Assistant worktrees and local build scratch.
.claude/worktrees/
.claude/settings.local.json
.dist/

# EPSS history snapshots (~107 MB), fetched by `retrust lev --update`.
data/epss-history/

# Document rendering intermediates and duplicate deliverable output.
/tmp/
/output/

# Credentials and machine-local environment settings.
.env
.env.*
!.env.example
